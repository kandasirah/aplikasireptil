# REPTIL — contoh konfigurasi. Salin ke .env lalu sesuaikan nilainya.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_HOST=192.168.246.129
DATABASE_PORT=5432
DATABASE_NAME=aplikasireptil
DATABASE_USER=admin
DATABASE_PASSWORD=ubah-ini

APP_ENV=development
APP_DEBUG=true
APP_NAME=REPTIL

# Wajib diganti di produksi: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ubah-secret-ini-di-produksi
ACCESS_TOKEN_EXPIRE_MINUTES=480
