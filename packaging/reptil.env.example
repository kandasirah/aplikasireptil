# ---------------------------------------------------------------------------
# REPTIL - konfigurasi runtime
#
# Berkas ini dibaca oleh:
#   - systemd (EnvironmentFile= pada reptil.service)
#   - perintah CLI reptil-run / reptil-migrate / reptil-seed / reptil-check
#     (di-source sebagai shell script)
#
# PostgreSQL dipasang TERPISAH dari paket ini. Arahkan ke instance yang sudah
# ada (boleh di mesin lain). Paket ini tidak pernah membuka port PostgreSQL,
# jadi tidak akan bentrok dengan Postgres/pgAdmin.
#
# Nilai TIDAK boleh memakai spasi kecuali diberi tanda kutip, mis.:
#   DATABASE_PASSWORD='pass word$ku'
# ---------------------------------------------------------------------------

# --- Koneksi database -------------------------------------------------------
# Cukup isi DATABASE_URL (prioritas utama). Komponen di bawah dipakai sebagai
# cadangan bila DATABASE_URL dibiarkan kosong.
DATABASE_URL=postgresql+psycopg://reptil:UBAH_PASSWORD@127.0.0.1:5432/aplikasireptil
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=aplikasireptil
DATABASE_USER=reptil
DATABASE_PASSWORD=UBAH_PASSWORD

# --- Lingkungan aplikasi ----------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_NAME=REPTIL

# --- Bind web aplikasi ------------------------------------------------------
# Hindari 5432 (PostgreSQL), 5050 (pgAdmin), 8000 (dev uvicorn).
# APP_HOST=127.0.0.1 -> hanya lokal. Pakai 0.0.0.0 bila diakses dari jaringan.
APP_HOST=127.0.0.1
APP_PORT=8010

# --- Keamanan ---------------------------------------------------------------
# Ganti dengan: /opt/reptil/venv/bin/python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=UBAH_SECRET_INI
ACCESS_TOKEN_EXPIRE_MINUTES=480
