#!/bin/sh
# prerm - hentikan service sebelum paket dilepas/di-deconfigure.
# Tidak menonaktifkan service saat upgrade.
set -eu

case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            if command -v deb-systemd-invoke >/dev/null 2>&1; then
                deb-systemd-invoke stop reptil.service >/dev/null 2>&1 || true
            else
                systemctl stop reptil.service >/dev/null 2>&1 || true
            fi
        fi
        ;;
    upgrade|failed-upgrade)
        ;;
    *)
        ;;
esac

exit 0
