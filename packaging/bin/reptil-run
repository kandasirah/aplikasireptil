#!/bin/sh
# REPTIL - jalankan server web (uvicorn). Dipakai oleh reptil.service.
set -eu

[ -r /etc/reptil/reptil.env ] && . /etc/reptil/reptil.env

export PYTHONPATH="/opt/reptil/app/src${PYTHONPATH:+:$PYTHONPATH}"
: "${APP_HOST:=127.0.0.1}"
: "${APP_PORT:=8010}"

cd /opt/reptil/app
exec /opt/reptil/venv/bin/uvicorn reptil.main:app \
    --host "$APP_HOST" \
    --port "$APP_PORT" \
    --proxy-headers \
    --forwarded-allow-ips "${FORWARDED_ALLOW_IPS:-127.0.0.1}"
